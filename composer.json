{
    "name": "nhzex/think-phinx",
    "type": "library",
    "description": "Phinx integration for thinkphp",
    "keywords": [
        "thinkphp",
        "thinkphp6",
        "thinkphp8",
        "phinx",
        "migration"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "auooru",
            "email": "auooru@outlook.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-64bit": ">=8.1",
        "composer-runtime-api": "^2.1",
        "psr/container": "^1.0 || ^2.0",
        "robmorgan/phinx": "~0.16.12",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "topthink/framework": "~6.0|~6.1|~8.0|~8.1",
        "topthink/think-orm": "^2.0.30|^3.0|^4.0",
        "zxin/phinx-schema": "^2.1.1",
        "zxin/think-symfony-bridge": "dev-fix/symfony-7-compat",
        "cakephp/database": "^5.2.15",
        "topthink/think-helper": "^3.1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "HZEX\\Phinx\\": "src",
            "Zxin\\Think\\Phinx\\": "src-next"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\Phinx\\": "tests"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Zxin\\Think\\Phinx\\Service"
            ],
            "config": {
                "phinx": "config/phinx.php"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:autoload": [
            "@php tests/check-autoload.php",
            "@php tests/check-autoload.php --predefined-env"
        ]
    },
    "conflict": {
        "cakephp/database": ">=5.3 <5.3.7"
    }
}
